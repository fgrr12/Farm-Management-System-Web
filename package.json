{
	"name": "cattle",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"local": "vite --mode local-develop",
		"dev": "vite --mode develop",
		"prod": "vite --mode production",
		"build:develop": "tsc && vite build --mode develop",
		"build:production": "tsc && vite build --mode production",
		"preview": "vite preview",
		"test": "vitest",
		"lint": "biome check . --write",
		"format": "biome format --write .",
		"migrate": "biome migrate --write",
		"lint:check": "biome check .",
		"format:check": "biome format .",
		"i18n:scan": "i18next-scanner --config i18next-scanner.config.cjs",
		"i18n:format": "biome format public/locales --write",
		"i18n": "npm run i18n:scan && npm run i18n:format",
		"pwa:generate": "pwa-assets-generator --preset minimal-2023 --override"
	},
	"dependencies": {
		"@atlaskit/pragmatic-drag-and-drop": "^3.0.0",
		"@floating-ui/react": "^0.27.20",
		"@hookform/resolvers": "^5.9.1",
		"@tanstack/query-async-storage-persister": "^5.101.4",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-query-persist-client": "^5.101.4",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.23",
		"firebase": "^12.17.1",
		"i18next": "^26.3.6",
		"i18next-browser-languagedetector": "^8.2.1",
		"i18next-http-backend": "^4.0.1",
		"react": "^19.2.8",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.85.0",
		"react-i18next": "^17.0.11",
		"react-router-dom": "7.18.2",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query-devtools": "^5.101.4",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vite-pwa/assets-generator": "^1.0.2",
		"@vitejs/plugin-react": "^6.0.5",
		"daisyui": "^5.7.18",
		"i18next-scanner": "^4.6.0",
		"jsdom": "^30.0.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"unocss": "^66.7.5",
		"vite": "^8.2.1",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.10",
		"workbox-core": "^7.4.1",
		"workbox-precaching": "^7.4.1",
		"workbox-routing": "^7.4.1",
		"workbox-window": "^7.4.1"
	}
